"""Main game class for Flair using the refactored architecture."""

import random
import math
from typing import Optional, List

import pygame

from .entities import Customer, Projectile, ParticleSystem
from .managers import AssetManager, AudioManager, Settings
from .ui import Button, Slider
from .utils.constants import (
    SCREEN_WIDTH, SCREEN_HEIGHT, FPS, COLORS, GameState, DrinkType,
    INITIAL_LIVES, INITIAL_INVENTORY, BASE_SPAWN_DELAY, BASE_CUSTOMER_SPEED,
    INITIAL_WAVE_SIZE, MAX_WAVE_SIZE, RESTOCK_DURATION, RESTOCK_AMOUNT,
    BASE_POINTS, POINTS_PER_WAVE, BAR_SIZE, BUTTON_WIDTH, BUTTON_HEIGHT
)


class FlairGame:
    """Modern refactored Flair game class."""
    
    def __init__(self):
        """Initialize the game."""
        pygame.init()
        pygame.joystick.init()
        
        # Display
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Flair!")
        self.clock = pygame.time.Clock()
        self.running = True
        
        # Managers
        self.settings = Settings.load()
        self.assets = AssetManager()
        self.audio = AudioManager(self.settings)
        
        # Load resources
        self.assets.load_all()
        self.audio.initialize()
        
        # Game state
        self.state = GameState.MAIN_MENU
        self.paused = False
        
        # Sprite groups - Using RenderUpdates for better performance
        self.customers = pygame.sprite.RenderUpdates()
        self.projectiles = pygame.sprite.RenderUpdates()
        self.particle_system = ParticleSystem()
        
        # Controller
        self.controller = None
        self.init_controller()
        
        # UI
        self.setup_menus()
        
        # Game variables
        self.reset_game_state()
        
        # Floor pattern
        self.floor_surface = self.assets.create_floor_pattern(SCREEN_WIDTH, SCREEN_HEIGHT)
    
    def init_controller(self):
        """Initialize game controller if available."""
        if pygame.joystick.get_count() > 0:
            self.controller = pygame.joystick.Joystick(0)
            self.controller.init()
            print(f"Controller connected: {self.controller.get_name()}")
    
    def reset_game_state(self):
        """Reset all game variables for a new game."""
        self.player_x = SCREEN_WIDTH // 2
        self.player_y = SCREEN_HEIGHT // 2
        self.score = 0
        self.wave = 1
        self.lives = INITIAL_LIVES
        self.customers_served = 0
        self.selected_drink = DrinkType.BEER
        
        self.inventory = {
            DrinkType.BEER: INITIAL_INVENTORY,
            DrinkType.WINE: INITIAL_INVENTORY,
            DrinkType.COCKTAIL: INITIAL_INVENTORY
        }
        
        # Clear sprite groups
        self.customers.empty()
        self.projectiles.empty()
        self.particle_system.particles.empty()
        
        # Wave management
        self.wave_timer = 0
        self.spawn_timer = 0
        self.customers_in_wave = 0
        self.wave_size = INITIAL_WAVE_SIZE
        
        # Restock
        self.is_restocking = False
        self.restock_timer = 0
    
    def setup_menus(self):
        """Setup menu buttons."""
        center_x = SCREEN_WIDTH // 2 - BUTTON_WIDTH // 2
        start_y = 220
        spacing = 80
        
        font = self.assets.get_font('normal')
        
        self.main_menu_buttons = [
            Button(center_x, start_y, BUTTON_WIDTH, BUTTON_HEIGHT, 
                  "New Game", font, self.start_new_game),
            Button(center_x, start_y + spacing, BUTTON_WIDTH, BUTTON_HEIGHT,
                  "Settings", font, self.show_settings),
            Button(center_x, start_y + spacing * 2, BUTTON_WIDTH, BUTTON_HEIGHT,
                  "Quit", font, self.quit_game)
        ]
        
        self.settings_buttons = [
            Button(50, SCREEN_HEIGHT - 80, 100, 40,
                  "Back", font, self.show_main_menu)
        ]
        
        # Audio sliders
        self.sound_slider = Slider(350, 290, 250, 0.0, 1.0,
                                   self.settings.sound_volume, "Sound Volume")
        self.music_slider = Slider(350, 360, 250, 0.0, 1.0,
                                   self.settings.music_volume, "Music Volume")
    
    def start_new_game(self):
        """Start a new game."""
        self.reset_game_state()
        self.state = GameState.PLAYING
        self.audio.play_music()
    
    def show_main_menu(self):
        """Show main menu."""
        self.state = GameState.MAIN_MENU
    
    def show_settings(self):
        """Show settings menu."""
        self.state = GameState.SETTINGS
    
    def quit_game(self):
        """Quit the game."""
        self.settings.save()
        self.running = False
    
    def spawn_customer(self):
        """Spawn a new customer."""
        if self.customers_in_wave >= self.wave_size:
            return
        
        # Random spawn location on screen edge
        spawn_locations = [
            (-30, random.randint(100, SCREEN_HEIGHT - 100)),
            (SCREEN_WIDTH + 30, random.randint(100, SCREEN_HEIGHT - 100)),
            (random.randint(100, SCREEN_WIDTH - 100), -30),
            (random.randint(100, SCREEN_WIDTH - 100), SCREEN_HEIGHT + 30)
        ]
        
        spawn_x, spawn_y = random.choice(spawn_locations)
        drink_type = random.choice(list(DrinkType))
        
        # Speed increases 5% per wave
        speed_multiplier = 1.05 ** (self.wave - 1)
        customer_speed = BASE_CUSTOMER_SPEED * speed_multiplier
        
        customer = Customer(spawn_x, spawn_y, self.player_x, self.player_y,
                           drink_type, customer_speed)
        self.customers.add(customer)
        self.customers_in_wave += 1
    
    def throw_drink(self, target_x: float, target_y: float):
        """Throw a drink projectile."""
        if self.is_restocking or self.inventory[self.selected_drink] <= 0:
            return
        
        projectile = Projectile(self.player_x, self.player_y,
                               target_x, target_y, self.selected_drink)
        self.projectiles.add(projectile)
        self.inventory[self.selected_drink] -= 1
        
        self.audio.play_sound('throw_drink')
        
        # Auto-switch to available drink
        if self.inventory[self.selected_drink] <= 0:
            for drink_type in DrinkType:
                if self.inventory[drink_type] > 0:
                    self.selected_drink = drink_type
                    break
    
    def start_restock(self):
        """Start restocking drinks."""
        if not self.is_restocking:
            self.is_restocking = True
            self.restock_timer = RESTOCK_DURATION
    
    def update_restock(self):
        """Update restock timer."""
        if self.is_restocking:
            self.restock_timer -= 1
            if self.restock_timer <= 0:
                for drink_type in DrinkType:
                    self.inventory[drink_type] = RESTOCK_AMOUNT
                self.is_restocking = False
                self.audio.play_sound('restock')
    
    def check_collisions(self):
        """Check collisions between projectiles and customers."""
        for projectile in list(self.projectiles):
            for customer in list(self.customers):
                if customer.served:
                    continue
                
                if projectile.rect.colliderect(customer.rect):
                    if projectile.drink_type == customer.drink_type:
                        # Correct drink
                        points = BASE_POINTS + (self.wave - 1) * POINTS_PER_WAVE
                        self.score += points
                        self.customers_served += 1
                        customer.set_served(successful=True)
                        
                        # Particles
                        color = COLORS[f'{projectile.drink_type.name.lower()}']
                        self.particle_system.create_burst(customer.x, customer.y, color)
                        
                        self.audio.play_sound('order_success')
                    else:
                        # Wrong drink
                        self.lives -= 1
                        customer.set_served(successful=False)
                        self.particle_system.create_burst(customer.x, customer.y, 
                                                         COLORS['particle_splat'])
                        self.audio.play_sound('order_fail')
                        
                        if self.lives <= 0:
                            self.game_over()
                            return
                    
                    projectile.kill()
                    break
    
    def game_over(self):
        """Handle game over."""
        self.state = GameState.GAME_OVER
    
    def update_game(self):
        """Update game logic."""
        if self.paused:
            return
        
        # Spawn customers
        current_spawn_delay = max(30, BASE_SPAWN_DELAY - (self.wave - 1) * 8)
        if self.customers_in_wave < self.wave_size:
            self.spawn_timer += 1
            if self.spawn_timer >= current_spawn_delay:
                self.spawn_customer()
                self.spawn_timer = 0
        
        # Update entities
        self.customers.update()
        
        # Update projectiles
        for projectile in list(self.projectiles):
            if not projectile.update():
                projectile.kill()
        
        # Update particles
        self.particle_system.update()
        
        # Update restock
        self.update_restock()
        
        # Check collisions
        self.check_collisions()
        
        # Check if customers reached bar
        for customer in list(self.customers):
            if customer.has_reached_bar():
                self.lives -= 1
                customer.kill()
                self.particle_system.create_burst(customer.x, customer.y,
                                                 COLORS['particle_splat'])
                self.audio.play_sound('customer_reach_bar')
                
                if self.lives <= 0:
                    self.game_over()
        
        # Check wave completion
        if (self.customers_in_wave >= self.wave_size and
            len([c for c in self.customers if not c.served]) == 0):
            self.wave += 1
            self.customers_in_wave = 0
            self.wave_size = min(INITIAL_WAVE_SIZE + (self.wave - 1) * 2, MAX_WAVE_SIZE)
    
    def handle_events(self):
        """Handle input events."""
        mouse_pos = pygame.mouse.get_pos()
        mouse_clicked = False
        mouse_pressed = pygame.mouse.get_pressed()[0]
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.quit_game()
            
            elif event.type == pygame.MOUSEBUTTONDOWN:
                if event.button == 1:
                    mouse_clicked = True
            
            elif event.type == pygame.KEYDOWN:
                if self.state == GameState.PLAYING:
                    if event.key == pygame.K_1 and self.inventory[DrinkType.BEER] > 0:
                        self.selected_drink = DrinkType.BEER
                    elif event.key == pygame.K_2 and self.inventory[DrinkType.WINE] > 0:
                        self.selected_drink = DrinkType.WINE
                    elif event.key == pygame.K_3 and self.inventory[DrinkType.COCKTAIL] > 0:
                        self.selected_drink = DrinkType.COCKTAIL
                    elif event.key == pygame.K_r:
                        self.start_restock()
                    elif event.key == pygame.K_p:
                        self.paused = not self.paused
                    elif event.key == pygame.K_ESCAPE:
                        self.show_main_menu()
        
        # Update UI based on state
        if self.state == GameState.MAIN_MENU:
            for button in self.main_menu_buttons:
                button.update(mouse_pos, mouse_clicked)
        
        elif self.state == GameState.SETTINGS:
            for button in self.settings_buttons:
                button.update(mouse_pos, mouse_clicked)
            
            # Update sliders
            if self.sound_slider.update(mouse_pos, mouse_pressed, mouse_clicked):
                self.audio.set_sound_volume(self.sound_slider.get_value())
            
            if self.music_slider.update(mouse_pos, mouse_pressed, mouse_clicked):
                self.audio.set_music_volume(self.music_slider.get_value())
        
        elif self.state == GameState.PLAYING:
            if mouse_clicked and not self.paused:
                self.throw_drink(mouse_pos[0], mouse_pos[1])
    
    def draw_background(self):
        """Draw the background."""
        if self.floor_surface:
            self.screen.blit(self.floor_surface, (0, 0))
        else:
            self.screen.fill(COLORS['bg'])
    
    def draw_bar(self):
        """Draw the bar."""
        bar_rect = pygame.Rect(self.player_x - BAR_SIZE//2, self.player_y - BAR_SIZE//2,
                               BAR_SIZE, BAR_SIZE)
        pygame.draw.rect(self.screen, COLORS['bar'], bar_rect)
        
        inner_rect = bar_rect.inflate(-10, -10)
        pygame.draw.rect(self.screen, COLORS['bar_top'], inner_rect)
        
        # Crosshair
        pygame.draw.circle(self.screen, COLORS['crosshair'],
                          (self.player_x, self.player_y), 8, 2)
    
    def draw_customers(self):
        """Draw all customers."""
        for customer in self.customers:
            # Draw customer circle
            color = COLORS['customer'] if not customer.served else COLORS['customer_served']
            pygame.draw.circle(self.screen, color, (int(customer.x), int(customer.y)), 
                             customer.size)
            
            if not customer.served:
                # Draw drink icon above head
                icon_name = f'{customer.drink_type.name.lower()}_icon'
                icon = self.assets.get_image(icon_name)
                if icon:
                    icon_rect = icon.get_rect(center=(int(customer.x), int(customer.y - 35)))
                    self.screen.blit(icon, icon_rect)
            
            # Draw dialogue
            if customer.dialogue and customer.dialogue_timer > 0:
                font = self.assets.get_font('small')
                color = COLORS['text_green'] if customer.service_successful else COLORS['text_red']
                text = font.render(customer.dialogue, True, color)
                text_rect = text.get_rect(center=(customer.x, customer.y - 55))
                self.screen.blit(text, text_rect)
    
    def draw_projectiles(self):
        """Draw all projectiles."""
        for projectile in self.projectiles:
            icon_name = f'{projectile.drink_type.name.lower()}_icon'
            icon = self.assets.get_image(icon_name)
            if icon:
                # Rotate for effect
                rotated = pygame.transform.rotate(icon, projectile.angle)
                rect = rotated.get_rect(center=(int(projectile.x), int(projectile.y)))
                self.screen.blit(rotated, rect)
            else:
                color = COLORS[projectile.drink_type.name.lower()]
                pygame.draw.circle(self.screen, color, (int(projectile.x), int(projectile.y)),
                                 projectile.size)
    
    def draw_ui(self):
        """Draw the game UI."""
        font = self.assets.get_font('normal')
        small_font = self.assets.get_font('small')
        
        # Score and wave
        score_text = font.render(f"Score: {self.score}", True, COLORS['text_white'])
        self.screen.blit(score_text, (10, 10))
        
        wave_text = font.render(f"Wave: {self.wave}", True, COLORS['text_white'])
        self.screen.blit(wave_text, (10, 50))
        
        # Lives
        lives_text = font.render(f"Lives: {self.lives}", True, COLORS['text_white'])
        self.screen.blit(lives_text, (10, 90))
        
        # Inventory
        inv_y = 10
        for i, drink_type in enumerate(DrinkType):
            x = SCREEN_WIDTH - 200 + i * 60
            
            # Highlight selected
            if drink_type == self.selected_drink:
                pygame.draw.circle(self.screen, COLORS['text_gold'], (x, inv_y + 20), 25, 3)
            
            # Draw icon
            icon_name = f'{drink_type.name.lower()}_icon'
            icon = self.assets.get_image(icon_name)
            if icon:
                self.screen.blit(icon, (x - 16, inv_y))
            
            # Count
            count_text = small_font.render(str(self.inventory[drink_type]), True, 
                                          COLORS['text_white'])
            self.screen.blit(count_text, (x - 5, inv_y + 35))
        
        # Restock overlay
        if self.is_restocking:
            overlay = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SRCALPHA)
            overlay.fill((0, 0, 0, 150))
            self.screen.blit(overlay, (0, 0))
            
            restock_text = font.render("RESTOCKING...", True, COLORS['text_gold'])
            text_rect = restock_text.get_rect(center=(SCREEN_WIDTH//2, SCREEN_HEIGHT//2))
            self.screen.blit(restock_text, text_rect)
        
        # Pause overlay
        if self.paused:
            pause_text = font.render("PAUSED", True, COLORS['text_gold'])
            text_rect = pause_text.get_rect(center=(SCREEN_WIDTH//2, SCREEN_HEIGHT//2))
            self.screen.blit(pause_text, text_rect)
    
    def draw_main_menu(self):
        """Draw main menu."""
        self.screen.fill(COLORS['menu_bg'])
        
        title_font = self.assets.get_font('title')
        title = title_font.render("Flair!", True, COLORS['text_gold'])
        title_rect = title.get_rect(center=(SCREEN_WIDTH//2, 100))
        self.screen.blit(title, title_rect)
        
        for button in self.main_menu_buttons:
            button.draw(self.screen)
    
    def draw_settings(self):
        """Draw settings menu."""
        self.screen.fill(COLORS['menu_bg'])
        
        title_font = self.assets.get_font('large')
        title = title_font.render("Settings", True, COLORS['text_gold'])
        title_rect = title.get_rect(center=(SCREEN_WIDTH//2, 100))
        self.screen.blit(title, title_rect)
        
        small_font = self.assets.get_font('small')
        self.sound_slider.draw(self.screen, small_font)
        self.music_slider.draw(self.screen, small_font)
        
        for button in self.settings_buttons:
            button.draw(self.screen)
    
    def draw_game_over(self):
        """Draw game over screen."""
        self.screen.fill(COLORS['menu_bg'])
        
        title_font = self.assets.get_font('large')
        title = title_font.render("Game Over!", True, COLORS['text_red'])
        title_rect = title.get_rect(center=(SCREEN_WIDTH//2, 100))
        self.screen.blit(title, title_rect)
        
        font = self.assets.get_font('normal')
        score_text = font.render(f"Final Score: {self.score}", True, COLORS['text_white'])
        score_rect = score_text.get_rect(center=(SCREEN_WIDTH//2, 200))
        self.screen.blit(score_text, score_rect)
        
        wave_text = font.render(f"Wave Reached: {self.wave}", True, COLORS['text_white'])
        wave_rect = wave_text.get_rect(center=(SCREEN_WIDTH//2, 250))
        self.screen.blit(wave_text, wave_rect)
        
        # Simple restart button
        restart_button = Button(SCREEN_WIDTH//2 - 100, 350, 200, 50,
                               "Play Again", font, self.start_new_game)
        menu_button = Button(SCREEN_WIDTH//2 - 100, 420, 200, 50,
                            "Main Menu", font, self.show_main_menu)
        
        mouse_pos = pygame.mouse.get_pos()
        mouse_clicked = pygame.mouse.get_pressed()[0]
        
        restart_button.update(mouse_pos, mouse_clicked)
        menu_button.update(mouse_pos, mouse_clicked)
        
        restart_button.draw(self.screen)
        menu_button.draw(self.screen)
    
    def run(self):
        """Main game loop."""
        self.audio.play_music()
        
        while self.running:
            self.handle_events()
            
            # Update based on state
            if self.state == GameState.PLAYING:
                self.update_game()
            
            # Draw based on state
            if self.state == GameState.MAIN_MENU:
                self.draw_main_menu()
            elif self.state == GameState.SETTINGS:
                self.draw_settings()
            elif self.state == GameState.GAME_OVER:
                self.draw_game_over()
            elif self.state == GameState.PLAYING:
                self.draw_background()
                self.draw_bar()
                self.draw_customers()
                self.draw_projectiles()
                self.particle_system.draw(self.screen)
                self.draw_ui()
            
            pygame.display.flip()
            self.clock.tick(FPS)
        
        self.settings.save()
        pygame.quit()